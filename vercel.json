{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/minecraft-site/browser",
  "routes": [
    { "src": "/api/auth/(.*)", "dest": "/api/auth.js" },
    { "src": "/api/auth", "dest": "/api/auth.js" },
    { "src": "/api/support/tickets/(.*)", "dest": "/api/tickets.js" },
    { "src": "/api/support/tickets", "dest": "/api/tickets.js" },
    { "src": "/api/tickets/(.*)", "dest": "/api/tickets.js" },
    { "src": "/api/tickets", "dest": "/api/tickets.js" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
