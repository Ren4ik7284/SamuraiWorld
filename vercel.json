{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/minecraft-site/browser",
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth.js" },
    { "source": "/api/auth", "destination": "/api/auth.js" },
    { "source": "/api/info", "destination": "/api/info.js" },
    { "source": "/api/news", "destination": "/api/news.js" },
    { "source": "/api/support/tickets/:path*", "destination": "/api/tickets.js" },
    { "source": "/api/support/tickets", "destination": "/api/tickets.js" },
    { "source": "/api/tickets/:path*", "destination": "/api/tickets.js" },
    { "source": "/api/tickets", "destination": "/api/tickets.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
